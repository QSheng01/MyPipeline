#pragma kernel CSMain

#pragma multi_compile _ _MAIN_LIGHT_SHADOWS_CASCADE
#pragma multi_compile _ MAIN_LIGHT_CALCULATE_SHADOWS

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/VolumeRendering.hlsl"
#include "VoxelVolumetricCommon.hlsl"

RWTexture3D<float4> LightingDataTex;
Texture3D<float4> LightingDataTexPrevious;
Texture3D<float4> MediaData;

#define MAX_VOLUME_COUNT 8
int _LocalVolumeCount;
float4x4 _LocalFogMatrix[MAX_VOLUME_COUNT];
float3 _LocalVolumeAlbedo[MAX_VOLUME_COUNT];
float _VolumeBlendDistance[MAX_VOLUME_COUNT];
int _VolumeBlendMode[MAX_VOLUME_COUNT];

#define MAX_LIGHT_COUNT 8
float _LightCountVoxel;
float3 _LightPosVoxel[MAX_LIGHT_COUNT];
float _AddLightIntensityVoxel[MAX_LIGHT_COUNT];
float3 _LightColorVoxel[MAX_LIGHT_COUNT];
float3 _LightDirectionVoxel[MAX_LIGHT_COUNT];
float4 _LightAngleVoxel[MAX_LIGHT_COUNT]; // x and y are spot angles (set to 0, 1 for point), z is squared bias, w is rcp(Range * Range);

float3 _WorldColor;//GI

//附加光衰减
float GetLightFalloff(float3 positionWS, float3 LightPositionWS, float4 LightAngle, float3 LightForward)
{
    float3 ray = LightPositionWS - positionWS;
    float d2 = dot(ray, ray);
    float distanceAttenuation = rcp(1.0 + d2);
    // Light range support
    #define USE_EXPERIMENTAL_LIGHT_RANGE
    #ifdef USE_EXPERIMENTAL_LIGHT_RANGE
    float factor = d2 * LightAngle.w;
    float smoothFactor = saturate(1.0 - factor*factor);
    smoothFactor *= smoothFactor;
    distanceAttenuation = distanceAttenuation * smoothFactor;
    #endif

    // Light biasing
    #define USE_EXPERIMENTAL_LIGHT_BIAS
    #ifdef USE_EXPERIMENTAL_LIGHT_BIAS
    if(d2 < LightAngle.z)
    {
        d2 *= rcp(LightAngle.z);
        distanceAttenuation *= d2;
    }
    #endif

    // Falloff over distance
    #define USE_EXPERIMENTAL_LIGHT_FALLOFF
    #ifdef USE_EXPERIMENTAL_LIGHT_FALLOFF
    float3 rayToCamera = _WorldSpaceCameraPos.xyz - positionWS;
    float distanceToCamera = sqrt(dot(rayToCamera, rayToCamera));
    float distanceToCameraAttenuation = 1.0 - (distanceToCamera * _InverseLightDistanceVolumetric);
    distanceAttenuation *= saturate(distanceToCameraAttenuation);
    #endif

    // Spot Attenuation
    float3 rayNormalized = normalize(ray);
    float dotDir = dot(rayNormalized, LightForward);
    float spotAttenuation = saturate((dotDir * LightAngle.x) + LightAngle.y);
    spotAttenuation *= spotAttenuation;
    distanceAttenuation *= spotAttenuation;

    return distanceAttenuation;
}

float3 mainLightDirection;
float3 mainLightColor;
float4 GetAdditionalLightData(float3 positionWS)
{
    float3 additionalLightsColor = float3(0,0,0);
	float additionalLightFallOff = 0;
    for (int lightIndex = 0; lightIndex < _LightCountVoxel; lightIndex++)
    {
        float lightFalloff = GetLightFalloff(positionWS, _LightPosVoxel[lightIndex], _LightAngleVoxel[lightIndex], _LightDirectionVoxel[lightIndex]);
        float3 lightColor = 
            _LightColorVoxel[lightIndex]
            * lightFalloff
            * _AddLightIntensityVoxel[lightIndex];
        
        additionalLightsColor += lightColor;
        additionalLightFallOff += lightFalloff;
    }

    return float4(additionalLightsColor,additionalLightFallOff);
}

float GetRealtimeShadows(float4 shadowCoord)
{
    // We just manually sample the shadowmap using unfiltered data.
    float4 shadowParams = GetMainLightShadowParams();
    float shadowStrength = shadowParams.x;
    float attenuation = _MainLightShadowmapTexture.SampleCmpLevelZero(sampler_LinearClampCompare, shadowCoord.xy, shadowCoord.z);
    return BEYOND_SHADOW_FAR(shadowCoord) ? 1.0 : attenuation;
}

float4 GetShadowCoord(float3 positionWS)
{
    #ifdef _MAIN_LIGHT_SHADOWS_CASCADE
    half cascadeIndex = ComputeCascadeIndex(positionWS);
    #else
    half cascadeIndex = half(0.0);
    #endif

    float4x4 mat = _MainLightWorldToShadow[cascadeIndex];
    float4 shadowCoord = mul(mat, float4(positionWS, 1.0));
	
    return float4(shadowCoord.xyz, 0);
}

float GetShadowAttenuation(float3 positionWS)
{
    float4 shadowCoord = GetShadowCoord(positionWS);
    return saturate(lerp(GetRealtimeShadows(shadowCoord), 1.0, GetMainLightShadowFade(positionWS)));
}

float _ColorInfluence;
float3 _SimpleColor[3];

//颜色调整
void EvaluateColorOverrides(in float distance01, inout float3 litColor, inout float3 shadedColor, inout float3 emitColor)
{
    if(_ColorInfluence < 1e-4)
        return;
    
    shadedColor = lerp(shadedColor, _SimpleColor[1], _ColorInfluence);
    litColor = lerp(litColor, _SimpleColor[0], _ColorInfluence);
    emitColor = _SimpleColor[2] * _ColorInfluence;
}

//散射hg计算
float HenyeyGreenstein(float3 rayDirectionWS, float eccentricity)
{
    float cosAngle = dot(mainLightDirection, rayDirectionWS);
    float e2 = eccentricity * eccentricity;
    float n = 1.0 - e2;
    float d = pow(abs(1.0 + e2 - 2.0 * eccentricity * cosAngle), 1.5);
    float nd = n/max(0.01,d);
    return nd * 0.78539;
}
//散射hg计算-废弃
float HenyeyGreensteinPhase(float G, float CosTheta)
{
    // Reference implementation (i.e. not schlick approximation). 
    // See http://www.pbr-book.org/3ed-2018/Volume_Scattering/Phase_Functions.html
    float Numer = 1.0f - G * G;
    float Denom = max(0.001,1.0f + G * G - 2.0f * G * CosTheta);
    return Numer / (4.0f * PI * Denom * sqrt(Denom));
}

//光照计算
float _Anisotropy;
float _LitIntensityVoxel;
float _ShadowIntensityVoxel;
float4 GetLighting(float3 positionWS, float3 rayDirectionWS, float distance01)
{
    float3 directLighting = mainLightColor;
    float3 ambientLighting = _WorldColor;
    
    float4 additionalLighting = GetAdditionalLightData(positionWS);

    float shading = GetShadowAttenuation(positionWS);
    float3 litColor = ambientLighting + directLighting;
    float3 shadedColor = ambientLighting;
    float3 emissionColor = 0;
    
    EvaluateColorOverrides(distance01, litColor, shadedColor, emissionColor);
    float hg = HenyeyGreenstein(rayDirectionWS, _Anisotropy);
    
    //局部雾效光照
    [loop]
    for (int i = 0; i < _LocalVolumeCount; i++) 
    {
        float d = 0;
        float4 posFogSpace = mul(_LocalFogMatrix[i], float4(positionWS,1));
        d = LocalFogBox(posFogSpace.xyz);
        float v = d / _VolumeBlendDistance[i];
        if(v<1)
            litColor *= _LocalVolumeAlbedo[i].rgb;
    }
    
    float3 lighting = lerp(shadedColor, litColor * hg * _LitIntensityVoxel, shading ) + emissionColor + additionalLighting.rgb;
    float density = lerp(_ShadowIntensityVoxel,_LitIntensityVoxel,shading);
    return float4(lighting ,saturate(density));
}

float _TemporalIntegration_Lighting;

[numthreads(8,8,8)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if(id.x >= (uint)fog_volume_size.x || id.y >= (uint)fog_volume_size.y || id.z >= (uint)fog_volume_size.z)
        return;

    float3 uvw = IdToUVW(id, fog_cell_size);
    
    float3 rayDirectionWS = GetRayDirectionCompute(uvw.xy);

    Light mainLight = GetMainLight();
    mainLightColor = mainLight.color;
    mainLightDirection = mainLight.direction;

    float3 positionWS = DirectionAndDistanceToWorldPosition(rayDirectionWS, uvw.z);
		
    float extinction = MediaData[id.xyz].a;
    float3 scattering = MediaData[id.xyz].xyz;
    float4 lighting = GetLighting(positionWS, rayDirectionWS, uvw.z);
    float3 newResult = lighting.rgb * scattering;
    extinction *= lighting.a;

    float4 finalResult = float4(newResult,extinction);
    LightingDataTex[id.xyz] = finalResult;
}